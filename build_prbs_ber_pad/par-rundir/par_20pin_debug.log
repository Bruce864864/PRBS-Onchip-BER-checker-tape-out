@file 212:
@file 213: set write_cells_ir "./find_regs_cells.json"
@file 214: set write_cells_ir [open $write_cells_ir "w"]
@file 215: puts $write_cells_ir "\["
@file 216:
@file 217: set refs [get_db [get_db lib_cells -if .is_sequential==true] .base_name]
@file 218:
@file 219: set len [llength $refs]
@file 220:
@file 221: for {set i 0} {$i < [llength $refs]} {incr i} {
            if {$i == $len - 1} {
                puts $write_cells_ir "    \"[lindex $refs $i]\""
            } else {
                puts $write_cells_ir "    \"[lindex $refs $i]\","
            }
        }
@file 228:
@file 229: puts $write_cells_ir "\]"
@file 230: close $write_cells_ir
@file 231: set write_regs_ir "./find_regs_paths.json"
@file 232: set write_regs_ir [open $write_regs_ir "w"]
@file 233: puts $write_regs_ir "\["
@file 234:
@file 235: set regs [get_db [get_db [all_registers -edge_triggered -output_pins] -if .direction==out] .name]
@file 236:
@file 237: set len [llength $regs]
@file 238:
@file 239: for {set i 0} {$i < [llength $regs]} {incr i} {
            #regsub -all {/} [lindex $regs $i] . myreg
            set myreg [lindex $regs $i]
            if {$i == $len - 1} {
                puts $write_regs_ir "    \"$myreg\""
            } else {
                puts $write_regs_ir "    \"$myreg\","
            }
        }
@file 248:
@file 249: puts $write_regs_ir "\]"
