@file 183: ln -sfn pre_write_regs latest
@file 184:
@file 185: set write_cells_ir "./find_regs_cells.json"
@file 186: set write_cells_ir [open $write_cells_ir "w"]
@file 187: puts $write_cells_ir "\["
@file 188:
@file 189: set refs [get_db [get_db lib_cells -if .is_sequential==true] .base_name]
@file 190:
@file 191: set len [llength $refs]
@file 192:
@file 193: for {set i 0} {$i < [llength $refs]} {incr i} {
            if {$i == $len - 1} {
                puts $write_cells_ir "    \"[lindex $refs $i]\""
            } else {
                puts $write_cells_ir "    \"[lindex $refs $i]\","
            }
        }
@file 200:
@file 201: puts $write_cells_ir "\]"
@file 202: close $write_cells_ir
@file 203: set write_regs_ir "./find_regs_paths.json"
@file 204: set write_regs_ir [open $write_regs_ir "w"]
@file 205: puts $write_regs_ir "\["
@file 206:
@file 207: set regs [get_db [get_db [all_registers -edge_triggered -output_pins] -if .direction==out] .name]
@file 208:
@file 209: set len [llength $regs]
@file 210:
@file 211: for {set i 0} {$i < [llength $regs]} {incr i} {
            #regsub -all {/} [lindex $regs $i] . myreg
            set myreg [lindex $regs $i]
            if {$i == $len - 1} {
                puts $write_regs_ir "    \"$myreg\""
            } else {
                puts $write_regs_ir "    \"$myreg\","
            }
        }
@file 220:
@file 221: puts $write_regs_ir "\]"
@file 222:
@file 223: close $write_regs_ir
