@file 207:
@file 208: set refs [get_db [get_db lib_cells -if .is_sequential==true] .base_name]
@file 209:
@file 210: set len [llength $refs]
@file 211:
@file 212: for {set i 0} {$i < [llength $refs]} {incr i} {
            if {$i == $len - 1} {
                puts $write_cells_ir "    \"[lindex $refs $i]\""
            } else {
                puts $write_cells_ir "    \"[lindex $refs $i]\","
            }
        }
