@file 193:
@file 194: set write_cells_ir "./find_regs_cells.json"
@file 195: set write_cells_ir [open $write_cells_ir "w"]
@file 196: puts $write_cells_ir "\["
@file 197:
@file 198: set refs [get_db [get_db lib_cells -if .is_sequential==true] .base_name]
@file 199:
@file 200: set len [llength $refs]
@file 201:
@file 202: for {set i 0} {$i < [llength $refs]} {incr i} {
            if {$i == $len - 1} {
                puts $write_cells_ir "    \"[lindex $refs $i]\""
            } else {
                puts $write_cells_ir "    \"[lindex $refs $i]\","
            }
        }
@file 209:
@file 210: puts $write_cells_ir "\]"
@file 211: close $write_cells_ir
@file 212: set write_regs_ir "./find_regs_paths.json"
@file 213: set write_regs_ir [open $write_regs_ir "w"]
@file 214: puts $write_regs_ir "\["
@file 215:
@file 216: set regs [get_db [get_db [all_registers -edge_triggered -output_pins] -if .direction==out] .name]
@file 217:
@file 218: set len [llength $regs]
@file 219:
@file 220: for {set i 0} {$i < [llength $regs]} {incr i} {
            #regsub -all {/} [lindex $regs $i] . myreg
            set myreg [lindex $regs $i]
            if {$i == $len - 1} {
                puts $write_regs_ir "    \"$myreg\""
            } else {
                puts $write_regs_ir "    \"$myreg\","
            }
        }
@file 229:
@file 230: puts $write_regs_ir "\]"
@file 231:
@file 232: close $write_regs_ir
