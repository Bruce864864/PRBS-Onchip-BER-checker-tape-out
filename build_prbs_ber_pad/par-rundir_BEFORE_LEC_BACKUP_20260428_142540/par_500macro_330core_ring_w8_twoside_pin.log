@file 1: # ============================================================
@file 2: # PRBS/BER core PG setup
@file 3: # ============================================================
@file 4:
@@file 5: set_db timing_enable_simultaneous_setup_hold_mode false
@file 6:
@@file 7: connect_global_net VDD -type pg_pin -pin_base_name VDD -all -override
