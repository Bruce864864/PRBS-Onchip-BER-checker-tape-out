@file 202: ln -sfn pre_write_regs latest
@file 203:
@file 204: set write_cells_ir "./find_regs_cells.json"
@file 205: set write_cells_ir [open $write_cells_ir "w"]
@file 206: puts $write_cells_ir "\["
@file 207:
@file 208: set refs [get_db [get_db lib_cells -if .is_sequential==true] .base_name]
@file 209:
@file 210: set len [llength $refs]
@file 211:
@file 212: for {set i 0} {$i < [llength $refs]} {incr i} {
            if {$i == $len - 1} {
                puts $write_cells_ir "    \"[lindex $refs $i]\""
            } else {
                puts $write_cells_ir "    \"[lindex $refs $i]\","
            }
        }
@file 219:
@file 220: puts $write_cells_ir "\]"
@file 221: close $write_cells_ir
@file 222: set write_regs_ir "./find_regs_paths.json"
@file 223: set write_regs_ir [open $write_regs_ir "w"]
@file 224: puts $write_regs_ir "\["
@file 225:
@file 226: set regs [get_db [get_db [all_registers -edge_triggered -output_pins] -if .direction==out] .name]
@file 227:
@file 228: set len [llength $regs]
@file 229:
@file 230: for {set i 0} {$i < [llength $regs]} {incr i} {
            #regsub -all {/} [lindex $regs $i] . myreg
            set myreg [lindex $regs $i]
            if {$i == $len - 1} {
                puts $write_regs_ir "    \"$myreg\""
            } else {
                puts $write_regs_ir "    \"$myreg\","
            }
        }
@file 239:
@file 240: puts $write_regs_ir "\]"
@file 241:
@file 242: close $write_regs_ir
