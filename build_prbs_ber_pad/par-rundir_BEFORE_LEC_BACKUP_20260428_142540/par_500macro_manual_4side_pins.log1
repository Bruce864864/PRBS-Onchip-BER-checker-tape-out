@file 1: # ============================================================
@file 2: # PRBS/BER core PG setup
@file 3: # ============================================================
@file 4:
@@file 5: set_db timing_enable_simultaneous_setup_hold_mode false
@file 6:
@@file 7: connect_global_net VDD -type pg_pin -pin_base_name VDD -all -override
@@file 8: connect_global_net VSS -type pg_pin -pin_base_name VSS -all -override
@file 9:
@file 10: # Expanded PG area: extend upper-layer stripes beyond core bbox
@file 11: # so they overlap the 8um/4um core ring.
@file 12:
@file 13: # For METAL4 vertical stripes:
@file 14: # keep X inside core, extend Y to top/bottom ring center.
@file 15: # For METAL5 horizontal stripes:
@file 16: # extend X to left/right ring center, keep Y inside core.
@file 17: set pg_area_m4 {84.88 68.0 415.28 432.3}
@file 18: set pg_area_m5 {68.0 84.88 432.3 415.28}
@file 19:
@file 20: puts "INFO: pg_area_m4 = $pg_area_m4"
INFO: pg_area_m4 = 84.88 68.0 415.28 432.3
@file 21: puts "INFO: pg_area_m5 = $pg_area_m5"
INFO: pg_area_m5 = 68.0 84.88 432.3 415.28
@file 22:
@file 23: # Power strap definition for layer METAL1 (rails):
@file 24:
@@file 25: reset_db -category add_stripes
@@file 26: set_db add_stripes_stacked_via_bottom_layer METAL1
@@file 27: set_db add_stripes_stacked_via_top_layer METAL1
@@file 28: set_db add_stripes_spacing_from_block 2.000
Global stripes will break 2.000000 user units from obstructed blocks.
@@file 29: add_stripes -pin_layer METAL1 -layer METAL1 -over_pins 1 -master "FILL2BWP7T" -block_ring_bottom_layer_limit METAL1 -block_ring_top_layer_limit METAL1 -pad_core_ring_bottom_layer_limit METAL1 -pad_core_ring_top_layer_limit METAL1 -direction horizontal -width pin_width -nets { VSS VDD }
