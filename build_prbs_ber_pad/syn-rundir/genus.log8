@file(syn.tcl) 66:         set write_cells_ir "./find_regs_cells.json"
@file(syn.tcl) 67:         set write_cells_ir [open $write_cells_ir "w"]
@file(syn.tcl) 68:         puts $write_cells_ir "\["
@file(syn.tcl) 70:         set refs [get_db [get_db lib_cells -if .is_sequential==true] .base_name]
@file(syn.tcl) 72:         set len [llength $refs]
@file(syn.tcl) 74:         for {set i 0} {$i < [llength $refs]} {incr i} {
            if {$i == $len - 1} {
                puts $write_cells_ir "    \"[lindex $refs $i]\""
            } else {
                puts $write_cells_ir "    \"[lindex $refs $i]\","
            }
        }
@file(syn.tcl) 82:         puts $write_cells_ir "\]"
@file(syn.tcl) 83:         close $write_cells_ir
@file(syn.tcl) 84:         set write_regs_ir "./find_regs_paths.json"
@file(syn.tcl) 85:         set write_regs_ir [open $write_regs_ir "w"]
@file(syn.tcl) 86:         puts $write_regs_ir "\["
@file(syn.tcl) 88:         set regs [get_db [get_db [all_registers -edge_triggered -output_pins] -if .direction==out] .name]
@file(syn.tcl) 90:         set len [llength $regs]
@file(syn.tcl) 92:         for {set i 0} {$i < [llength $regs]} {incr i} {
            #regsub -all {/} [lindex $regs $i] . myreg
            set myreg [lindex $regs $i]
            if {$i == $len - 1} {
                puts $write_regs_ir "    \"$myreg\""
            } else {
                puts $write_regs_ir "    \"$myreg\","
            }
        }
@file(syn.tcl) 102:         puts $write_regs_ir "\]"
@file(syn.tcl) 104:         close $write_regs_ir
