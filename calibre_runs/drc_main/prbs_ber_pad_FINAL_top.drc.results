OD.R.2 { @ {OD or DOD} local density (maximum) over window 500 um x 500 um stepping OD_R_Sum <= 0.8
         @ For OD.R.2, the following regions can be excluded:
         @   a.(CB sizing 2) for high speed/RF products
         @   b.ODBLK /RWDMY/FW/LMARK/LOGO/INDDMY as default
         @   c.Chip corner stress relief area if seal-ring & stress relief pattern added by TSMC
         @ This rule is applied while the area (checking window - the above excluded region) >= 1/4 checking window area
  N = ODx NOT OD_EXC
  D = CHIP NOT OD_EXC 
  A = CHIPx NOT OD_EXC
  X = DENSITY A ODx CHIP N D > OD_R_2 WINDOW OD_R_W STEP OD_R_S BACKUP INSIDE OF LAYER CHIPx PRINT OD.R.2.density RDB OD.R.2.RDB.density
          [~(OD_R_A-AREA(A))*AREA(N)/AREA(D)*!~(AREA(ODx)/AREA(CHIP)-OD_R_2)]
COPY X
}
