  A6 = NET AREA RATIO VIAD_Violate_S_6_A1 VIA1_6stack.Final >= VIA_D_1
  B1 = ((((A1 OR A2) OR A3) OR A4) OR A5) OR A6
  SIZE B1 BY VIA_Merge OVERUNDER 
}
